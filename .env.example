# FactGuard AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENV=development

# LLM Providers (Gemini / OpenAI / Anthropic / Local Mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Web Search Provider (duckduckgo / tavily / serpapi)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./factguard.db
CHROMA_DB_PATH=./chroma_db

# Security & Safety
SECRET_KEY=factguard_super_secret_key_2026
MAX_UPLOAD_SIZE_MB=10
ALLOWED_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Demo & Debug Mode
DEMO_MODE=true
